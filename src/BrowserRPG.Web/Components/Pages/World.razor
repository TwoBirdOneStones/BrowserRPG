
@page "/world"
@rendermode InteractiveServer
@using BrowserRPG.Core
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject SharedWorldState SharedWorld

<PageTitle>World Prototype - BrowserRPG</PageTitle>

<h1>BrowserRPG - World Prototype</h1>

<p>
    Move with A/D or the arrow keys.
    Jump with Space, W, or Up Arrow.
    Click or tap to move horizontally toward a destination.
</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    <button type="button"
            class="btn btn-outline-primary"
            @onclick="SelectMoveAsync">
        Move
    </button>

    <button type="button"
            class="btn btn-outline-primary"
            @onclick="SelectMineAsync">
        Mine
    </button>

    <button type="button"
            class="btn btn-outline-primary"
            @onclick="SelectPlaceAsync">
        Place Dirt
    </button>
</div>

<p>
    Selected tool: <strong>@_selectedTool</strong>
</p>


<canvas
    @ref="_canvas"
    tabindex="0"
    aria-label="2D game world"
    style="
        display: block;
        width: 100%;
        height: min(65vh, 560px);
        min-height: 300px;
        background: #8fcbe8;
        border: 2px solid #334155;
        border-radius: 8px;
        touch-action: none;">
</canvas>

<p class="mt-3 text-muted">
    This is a local rendering prototype.
    Multiplayer and persistence are not implemented yet.
</p>


@code {
    
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<World>? _selfReference;

    private bool _disposed;
    private string _selectedTool = "move";

    private Task SelectMoveAsync() => SetToolAsync("move");
    private Task SelectMineAsync() => SetToolAsync("mine");
    private Task SelectPlaceAsync() => SetToolAsync("place");

    private async Task SetToolAsync(string tool)
    {
        _selectedTool = tool;

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setTool", tool);
        }
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./js/world.js"
        );

        _selfReference = DotNetObjectReference.Create(this);

        await _module.InvokeVoidAsync(
            "start",
            _canvas,
            SharedWorld.Width,
            SharedWorld.Height,
            SharedWorld.GetSnapshot(),
            _selfReference
        );

        SharedWorld.BlockChanged += OnBlockChanged;
    }

    [JSInvokable]
    public Task RequestBlockEdit(
        int x, int y, string action)
    {
        if (!_disposed)
        {
            SharedWorld.TryEditBlock(x, y, action);
        }

        return Task.CompletedTask;
    }

    private void OnBlockChanged(BlockChange change)
    {
        _ = ForwardBlockChangeAsync(change);
    }

    private async Task ForwardBlockChangeAsync(
        BlockChange change)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed || _module is null)
                    return;

                await _module.InvokeVoidAsync(
                    "applyBlockChange",
                    change.X,
                    change.Y,
                    (byte)change.Block
                );
            });
        }
        catch (JSDisconnectedException)
        {
            // The browser disconnected.
        }
        catch (ObjectDisposedException)
        {
            // The component was disposed.
        }
        catch (InvalidOperationException) when (_disposed)
        {
            // The component's renderer has shut down.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        SharedWorld.BlockChanged -= OnBlockChanged;

        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser connection has closed.
        }
        finally
        {
            _selfReference?.Dispose();
        }
    }
}

