
@page "/world"
@rendermode InteractiveServer
@using BrowserRPG.Core
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>World Prototype - BrowserRPG</PageTitle>

<h1>BrowserRPG - World Prototype</h1>

<p>
    Use A/D or the arrow keys to move.
    Click or tap the world to walk toward a location.
</p>

<canvas
    @ref="_canvas"
    tabindex="0"
    aria-label="2D game world"
    style="
        display: block;
        width: 100%;
        height: min(65vh, 560px);
        min-height: 300px;
        background: #8fcbe8;
        border: 2px solid #334155;
        border-radius: 8px;
        touch-action: none;">
</canvas>

<p class="mt-3 text-muted">
    This is a local rendering prototype.
    Multiplayer and persistence are not implemented yet.
</p>

@code {
    private ElementReference _canvas;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./js/world.js"
        );

        WorldGenerator worldGenerator = new WorldGenerator();
        BlockType[] blocks = worldGenerator.blocks;

        await _module.InvokeVoidAsync(
            "start",
            _canvas,
            WorldGenerator.WIDTH,
            WorldGenerator.HEIGHT,
            blocks
        );
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
            return;

        try
        {
            await _module.InvokeVoidAsync("stop");
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Browser connection has already closed.
        }
    }
}
